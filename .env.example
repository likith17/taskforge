# Copy to .env (git-ignored) to override. docker compose reads .env for the
# database password; the taskforge binary reads plain environment variables.
TASKFORGE_DB_PASSWORD=taskforge

DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5434/taskforge
TASKFORGE_BIND=127.0.0.1:8080
# TASKFORGE_METRICS_BIND=127.0.0.1:9100   # /metrics for worker/scheduler roles
TASKFORGE_QUEUES=default
TASKFORGE_CONCURRENCY=4
TASKFORGE_POLL_INTERVAL_MS=250
TASKFORGE_LEASE_MS=30000
TASKFORGE_RETRY_BASE_MS=1000
TASKFORGE_RETRY_CAP_MS=300000
TASKFORGE_WORKER_REAPER=true
TASKFORGE_REAP_INTERVAL_MS=1000
TASKFORGE_RETENTION_SECS=604800
TASKFORGE_STATEMENT_TIMEOUT_MS=5000
TASKFORGE_SHUTDOWN_GRACE_SECS=30
TASKFORGE_MAX_BODY_BYTES=66560
TASKFORGE_DB_MAX_CONNECTIONS=10
# TASKFORGE_WORKER_ID=worker-1            # generated when unset; must be unique
# TASKFORGE_CHAOS_HANDLER=false           # test-only job kind for taskforge-chaos
TASKFORGE_LOG_FORMAT=text   # or json
RUST_LOG=info
