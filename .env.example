# Copy to .env (git-ignored) to override. docker compose reads .env for the
# database password; the taskforge binary reads plain environment variables.
TASKFORGE_DB_PASSWORD=taskforge

DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5434/taskforge
TASKFORGE_BIND=127.0.0.1:8080
TASKFORGE_QUEUES=default
TASKFORGE_POLL_INTERVAL_MS=250
TASKFORGE_LEASE_SECS=300
TASKFORGE_MAX_BODY_BYTES=65536
TASKFORGE_DB_MAX_CONNECTIONS=10
TASKFORGE_LOG_FORMAT=text   # or json
RUST_LOG=info
